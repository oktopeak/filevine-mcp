# Filevine Service Account Credentials
# Obtain from: Filevine Settings → Access Tokens (generate PAT) → Client Secrets (create ID + Secret)

FILEVINE_CLIENT_ID=
FILEVINE_CLIENT_SECRET=
FILEVINE_PAT=

# Filevine API region (us or ca)
FILEVINE_REGION=us

# AES-256-GCM encryption key for token storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
